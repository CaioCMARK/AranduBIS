{
  "ano": 2026,
  "classe": "regular",
  "nome": "SAE 2026 Regular",
  "fonte": "Regulamento_SAE_BRASIL_AeroDesign_2026_Rev00_EN.pdf, secao 7.7",
  "constantes": {
    "MTOW": 20.0,
    "NR_MAX": 185.0
  },
  "cenario": {
    "NR": 185.0,
    "n_superficies": 2.0,
    "envergadura": 0.0,
    "PV_previsto": 0.0,
    "CP_previsto": 0.0
  },
  "grandezas": [
    {
      "nome": "CP_util",
      "formula": "max(0, MTOW - PV)",
      "descricao": "carga que ainda cabe no MTOW",
      "unidade": "kg"
    },
    {
      "nome": "CP",
      "formula": "min(CP_bruta, CP_util)",
      "descricao": "carga paga que de fato pontua -- o excesso sobre o MTOW nao e considerado, R[7.6.0.1]",
      "unidade": "kg"
    },
    {
      "nome": "EE",
      "formula": "CP / PV if PV > 0 else 0",
      "descricao": "eficiencia estrutural",
      "unidade": ""
    },
    {
      "nome": "PV_prev",
      "formula": "PV_previsto if PV_previsto > 0 else PV",
      "descricao": "peso vazio declarado; 0 vira previsao perfeita",
      "unidade": "kg"
    },
    {
      "nome": "CP_prev",
      "formula": "CP_previsto if CP_previsto > 0 else CP",
      "descricao": "carga paga declarada; 0 vira previsao perfeita",
      "unidade": "kg"
    },
    {
      "nome": "erro_PV",
      "formula": "(PV_prev - PV) / PV_prev",
      "descricao": "erro relativo da previsao de PV",
      "unidade": ""
    },
    {
      "nome": "erro_CP",
      "formula": "abs((CP_prev - CP) / CP_prev)",
      "descricao": "erro relativo da previsao de CP",
      "unidade": ""
    },
    {
      "nome": "FPV",
      "formula": "max(0.80, 1.10 - 15 * erro_PV ** 2)",
      "descricao": "Eq. 7.3 -- multiplica o escore de voo inteiro; piso 0,80",
      "unidade": ""
    },
    {
      "nome": "FPR",
      "formula": "min(1.0, 0.50 + 0.75 * NR / NR_MAX)",
      "descricao": "Eq. 7.4",
      "unidade": ""
    },
    {
      "nome": "N",
      "formula": "min(max(trunc(n_superficies), 1), 3)",
      "descricao": "superficies de funcao longitudinal, limitado a 3",
      "unidade": ""
    },
    {
      "nome": "fator_N",
      "formula": "0.185 * N ** 2 - 0.775 * N + 1.81",
      "descricao": "Eq. 7.5 -- parabola com minimo em N = 2,09",
      "unidade": ""
    },
    {
      "nome": "fator_b",
      "formula": "1.15 ** (-envergadura)",
      "descricao": "Eq. 7.5 -- imposto exponencial sobre a envergadura",
      "unidade": ""
    },
    {
      "nome": "P_EE",
      "formula": "50 * EE",
      "descricao": "Eq. 7.2",
      "unidade": ""
    }
  ],
  "itens": [
    {
      "nome": "P_VOO",
      "formula": "FPV * FPR * P_EE * fator_N * fator_b",
      "descricao": "Eq. 7.5 -- escore de voo da bateria",
      "quando": ""
    },
    {
      "nome": "P_AC",
      "formula": "max(0, 30 - 830 * erro_CP ** 1.75)",
      "descricao": "Eq. 7.6 -- acuracia da previsao de carga paga, ate 30 pontos",
      "quando": ""
    },
    {
      "nome": "B_RC",
      "formula": "0 if (t < 0 or t >= 40) else min(20, 40 * (1 - (t / 40) ** 2))",
      "descricao": "Eq. 7.8 -- retirada da carga; teto de 20 ate 28,3 s",
      "quando": ""
    },
    {
      "nome": "B_PO",
      "formula": "2 * EE",
      "descricao": "Eq. 7.7 -- bonus por parar na area, melhor bateria",
      "quando": "parada_na_area"
    }
  ]
}